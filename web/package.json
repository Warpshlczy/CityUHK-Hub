{
  "name": "cityu-hub-web",
  "private": true,
  "version": "0.0.0",
  "description": "CityUHK Hub 前端：读取解析好的静态 JSON 并渲染站点",
  "type": "module",
  "scripts": {
    "parse": "node ../repos-parser/src/build-index.mjs --offline",
    "parse:online": "node ../repos-parser/src/build-index.mjs",
    "compile": "tsc -b && vite build && node ../scripts/prerender.mjs",
    "dev": "npm run parse && vite",
    "build": "npm run parse && npm run compile",
    "build:online": "npm run parse:online && npm run compile",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0"
  }
}
